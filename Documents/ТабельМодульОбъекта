
Процедура ОбработкаПроведения(Отказ, Режим)
	//{{__КОНСТРУКТОР_ДВИЖЕНИЙ_РЕГИСТРОВ
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!

	// регистр ОтработаноПоТабелю 
	Движения.ОтработаноПоТабелю.Записывать = Истина;
	Для Каждого ТекСтрокаСписокСотрудников Из СписокСотрудников Цикл
		
		Для Н = 0 По 6 Цикл
			Период = НачалоНедели + 86400 * Н;
		
		    Отработано = ТекСтрокаСписокСотрудников["Д" + (Н + 1)];
			Если Отработано > 0 Тогда
		        Движение = Движения.ОтработаноПоТабелю.Добавить();
		        Движение.Период = Период;
		        Движение.Сотрудник = ТекСтрокаСписокСотрудников.Сотрудник;
		        Движение.ОтработаноДней = Отработано;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	//}}__КОНСТРУКТОР_ДВИЖЕНИЙ_РЕГИСТРОВ
