
&НаСервере
Процедура РассчитатьСреднийБаллНаСервере() 
	Сумма = 0;
	Н = 0;
	Для Каждого ТекСтрока Из Объект.Ссылка.ЗачетныеЕдиницы Цикл
		Сумма = Сумма + ТекСтрока.Оценка; 
		Н = Н + 1;
	КонецЦикла;     
	Среднее = Сумма / Н;
	Объект.СреднийБалл = Окр(Среднее, 0);
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСреднийБалл(Команда)   
	ЭтотОбъект.Записать();
	РассчитатьСреднийБаллНаСервере();
КонецПроцедуры

