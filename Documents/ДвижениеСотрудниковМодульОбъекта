
Процедура ОбработкаПроведения(Отказ, Режим)
	//{{__КОНСТРУКТОР_ДВИЖЕНИЙ_РЕГИСТРОВ
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!

	// регистр КадроваяИсторияСотрудников
	Движения.КадроваяИсторияСотрудников.Записывать = Истина;
	Для Каждого ТекСтрокаСотрудники Из Сотрудники Цикл
		Движение = Движения.КадроваяИсторияСотрудников.Добавить();
		Движение.Сотрудник = ТекСтрокаСотрудники.ФИО;
		Движение.ДатаДвижения = Дата;                  
		
		Если  ТекСтрокаСотрудники.Образование = Перечисления.Образование.ДокторНаук Тогда
			
			Движение.ДокторНаук = ТекСтрокаСотрудники.ВидДвижения;
			Движение.Высшее = ТекСтрокаСотрудники.ВидДвижения; 
			
		ИначеЕсли ТекСтрокаСотрудники.Образование = Перечисления.Образование.КандидатНаук Тогда
			Движение.КандидатНаук = ТекСтрокаСотрудники.ВидДвижения;
			Движение.Высшее = ТекСтрокаСотрудники.ВидДвижения;     
			
		ИначеЕсли    		
			ТекСтрокаСотрудники.Образование = Перечисления.Образование.Высшее Тогда 
			Движение.Высшее = ТекСтрокаСотрудники.ВидДвижения;   
			
		ИначеЕсли ТекСтрокаСотрудники.Образование = Перечисления.Образование.СреднееПрофессиональное Тогда
			Движение.СреднееПрофессиональное = 	ТекСтрокаСотрудники.ВидДвижения;       
			
		Иначе
			Движение.Прочее = ТекСтрокаСотрудники.ВидДвижения;   
		КонецЕсли;
		
		
		Движение.Категория = ТекСтрокаСотрудники.КатегорияРаботника;
		Движение.ОбластьНауки = ТекСтрокаСотрудники.ФИО.ОбластьНауки;
	КонецЦикла;

	//}}__КОНСТРУКТОР_ДВИЖЕНИЙ_РЕГИСТРОВ
