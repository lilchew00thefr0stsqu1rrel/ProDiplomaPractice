Процедура РассчитатьЗаписи(Регистратор) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОсновныеНачисленияДанныеГрафика.НомерСтроки КАК НомерСтроки,
	               |	ОсновныеНачисленияДанныеГрафика.Параметр КАК Параметр,
	               |	ОсновныеНачисленияДанныеГрафика.Сторно КАК Сторно,
	               |	ОсновныеНачисленияДанныеГрафика.ПризнакПериодДействия КАК Норма,
	               |	ОсновныеНачисленияДанныеГрафика.ПризнакФактическийПериодДействия КАК Факт,
	               |	ОсновныеНачисленияБазаОсновныеНачисления.СуммаБаза КАК База,
	               |	ОсновныеНачисленияДанныеГрафика.ВидРасчета.СпособРасчета КАК СпособРасчета,
	               |	ОсновныеНачисленияБазаОсновныеНачисления.ОтработаноДнейБаза КАК ОтработаноДнейБаза,
	               |	ОсновныеНачисленияДанныеГрафика.ВидРасчета.УвеличиваетОтработанныеДни КАК УвеличиваетОтработанныеДни,
	               |	ЕСТЬNULL(ОтработаноПоТабелюОбороты.ОтработаноДнейОборот, 0) КАК ОтработаноДнейПоТабелю,
	               |	ОсновныеНачисленияДанныеГрафика.БазовыйПериодНачало КАК БазовыйПериодНачало,
	               |	ОсновныеНачисленияДанныеГрафика.БазовыйПериодКонец КАК БазовыйПериодКонец
	               |ИЗ
	               |	РегистрРасчета.ОсновныеНачисления.ДанныеГрафика(Регистратор = &Регистратор) КАК ОсновныеНачисленияДанныеГрафика
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрРасчета.ОсновныеНачисления.БазаОсновныеНачисления(&МассивИзмерений, &МассивИзмерений, , Регистратор = &Регистратор) КАК ОсновныеНачисленияБазаОсновныеНачисления
	               |		ПО ОсновныеНачисленияДанныеГрафика.НомерСтроки = ОсновныеНачисленияБазаОсновныеНачисления.НомерСтроки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОтработаноПоТабелю.Обороты(&НачалоМесяца, &КонецМесяца, , ) КАК ОтработаноПоТабелюОбороты
	               |		ПО ОсновныеНачисленияДанныеГрафика.Сотрудник = ОтработаноПоТабелюОбороты.Сотрудник
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерСтроки";
	
	МассивИзмерений = Новый Массив (1);
	МассивИзмерений[0] = "Сотрудник";
	Запрос.УстановитьПараметр("НачалоМесяца", НачалоМесяца(Регистратор.Дата));
	Запрос.УстановитьПараметр("КонецМесяца", КонецМесяца(Регистратор.Дата));
	
	
	Запрос.УстановитьПараметр("МассивИзмерений", МассивИзмерений);
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	РезультатЗапроса = Запрос.Выполнить();
	
	НаборЗаписей = РегистрыРасчета.ОсновныеНачисления.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(Регистратор);
	НаборЗаписей.Прочитать();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("НомерСтроки", );
	
	
//
	
	Для Каждого Запись Из НаборЗаписей Цикл
		
		СтруктураПоиска.НомерСтроки = Запись.НомерСтроки;
		
		Выборка.НайтиСледующий(СтруктураПоиска);
		
		Норма = Выборка.Норма;
		Факт = Выборка.Факт;
		База = Выборка.База;
		СпособРасчета = Выборка.СпособРасчета;
		Параметр = Выборка.Параметр;
		БазаДней = Выборка.ОтработаноДнейБаза;
		УвеличиваетОтработанныеДни = Выборка.УвеличиваетОтработанныеДни;
		ПоТабелю = Выборка.ОтработаноДнейПоТабелю;
		БазаМесяцев = МЕСЯЦ(Выборка.БазовыйПериодКонец) - 
		МЕСЯЦ(Выборка.БазовыйПериодНачало) + 1;
		
		
			
				
		Если СпособРасчета = Перечисления.СпособыРасчета.ФиксированнаяСумма Тогда	 	
	        Запись.Сумма = Параметр;
		ИначеЕсли СпособРасчета = Перечисления.СпособыРасчета.Процентом Тогда
			Запись.Сумма = База * Параметр / 100;
		ИначеЕсли СпособРасчета = Перечисления.СпособыРасчета.ЗаОтработанныеДни Тогда
			Запись.Сумма = Параметр * Факт;
		ИначеЕсли СпособРасчета = Перечисления.СпособыРасчета.ПоСреднему Тогда
			Запись.Сумма = База / БазаДней * Факт;
		ИначеЕсли СпособРасчета = Перечисления.СпособыРасчета.ПропорциональноОтработаннымДням Тогда
			Запись.Сумма = Факт / Норма * Параметр;
		ИначеЕсли СпособРасчета = Перечисления.СпособыРасчета.ПоТабелю Тогда
			Запись.Сумма = ПоТабелю * Параметр;
		ИначеЕсли СпособРасчета = Перечисления.СпособыРасчета.СреднееЗаПромежуток Тогда
			Запись.Сумма = База / БазаМесяцев;
		КонецЕсли;
		
		Если УвеличиваетОтработанныеДни Тогда 
			Запись.ОтработаноДней = Факт;
		КонецЕсли;
		
		Если Запись.Сторно Тогда
			Запись.Сумма = -Запись.Сумма;
			Запись.ОтработаноДней = -Запись.ОтработаноДней;
		КонецЕсли;
	КонецЦикла;
	
    НаборЗаписей.Записать(,,ЛОЖЬ);

КонецПроцедуры // РассчитатьЗаписи()                 



